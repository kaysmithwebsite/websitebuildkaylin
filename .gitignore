# Generated by build.py on every run, and rebuilt by Netlify from netlify.toml.
dist/

# Client photo originals. Inputs to tools_process_photos.py, which is run by
# hand; the build reads only the processed output already in assets/.
incoming-photos/

# RE/MAX marketing PDFs, 34MB of third-party copyrighted material licensed to
# the brokerage rather than to this repository. Excluded for two reasons: it is
# not ours to redistribute, and 34MB of binary does not belong in git history.
#
# The site serves them from assets/guides/, so they must be present locally to
# build a complete site. If you ever switch to git-based Netlify deploys, they
# need to come back in (behind Git LFS) or the guide downloads will 404.
assets/guides/*.pdf

# Netlify CLI local state. Contains the site id; nothing secret, but it is
# machine-local and not worth versioning.
.netlify/

kaylinsmith-preview.zip
.DS_Store

# --------------------------------------------------------------------------
# CRM (Node / Netlify Functions / Netlify Database)
# --------------------------------------------------------------------------
node_modules/

# Never committed: local secrets for `netlify dev` (ANTHROPIC_API_KEY,
# Google OAuth client secret, etc. — see the environment variable list in
# SECURITY.md). Real values live in Netlify's own environment variable
# store, not in a file.
.env
.env.local

# Scratch output of `npm run db:generate` (drizzle-kit). The committed,
# canonical migration lives in netlify/database/migrations/ — see
# scripts/sync-migrations.ts and DATABASE.md.
drizzle/generated/
